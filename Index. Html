<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Km Square | Premium Fashion</title>

<meta name="description" content="Discover timeless fashion and elegant collections at Km Square. Shop your favorite styles today.">

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --cream: #f8f3eb;
    --brown: #553b2b;
    --dark: #2c211b;
    --gold: #b18a58;
    --white: #ffffff;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: var(--cream);
    color: var(--dark);
    line-height: 1.6;
}

a {
    text-decoration: none;
    color: inherit;
}

header {
    background: rgba(248,243,235,.97);
    padding: 18px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid #e6d9c9;
}

.logo {
    font-family: Georgia, serif;
    font-size: 29px;
    font-weight: bold;
    letter-spacing: 2px;
    color: var(--brown);
}

.logo span {
    color: var(--gold);
}

nav {
    display: flex;
    align-items: center;
    gap: 25px;
}

nav a {
    font-size: 14px;
    transition: .3s;
}

nav a:hover {
    color: var(--gold);
}

.nav-btn {
    background: var(--brown);
    color: white;
    padding: 10px 18px;
    border-radius: 3px;
}

.hero {
    min-height: 580px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 65px 7%;
    gap: 40px;
}

.hero-text small {
    color: var(--gold);
    letter-spacing: 4px;
    font-weight: bold;
}

.hero h1 {
    font-family: Georgia, serif;
    font-size: clamp(40px, 5vw, 68px);
    line-height: 1.12;
    margin: 22px 0;
    color: var(--brown);
}

.hero p {
    color: #78695c;
    max-width: 450px;
    margin-bottom: 30px;
}

.btn {
    display: inline-block;
    padding: 14px 25px;
    background: var(--brown);
    color: white;
    border: 1px solid var(--brown);
    transition: .3s;
    cursor: pointer;
}

.btn:hover {
    background: var(--gold);
    border-color: var(--gold);
    transform: translateY(-2px);
}

.btn-outline {
    background: transparent;
    color: var(--brown);
    margin-left: 10px;
}

.hero-image {
    height: 450px;
    overflow: hidden;
    border-radius: 3px;
    background: #e6d8c7;
}

.hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.features {
    background: var(--brown);
    color: white;
    padding: 25px 7%;
    display: flex;
    justify-content: space-around;
    gap: 20px;
    text-align: center;
    flex-wrap: wrap;
}

.features div {
    font-size: 14px;
}

section {
    padding: 75px 7%;
}

.section-heading {
    text-align: center;
    margin-bottom: 40px;
}

.section-heading small {
    color: var(--gold);
    letter-spacing: 3px;
    font-weight: bold;
}

.section-heading h2 {
    font-family: Georgia, serif;
    font-size: 38px;
    color: var(--brown);
    margin-top: 8px;
}

.products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.product {
    background: white;
    padding-bottom: 22px;
    transition: .3s;
    border: 1px solid #eee4d8;
}

.product:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px #553b2b12;
}

.product img {
    width: 100%;
    height: 330px;
    object-fit: cover;
    display: block;
    background: #e6d8c7;
}

.product-info {
    padding: 20px 18px 0;
}

.product-info h3 {
    font-family: Georgia, serif;
    font-size: 21px;
    color: var(--brown);
}

.product-info p {
    color: #827366;
    font-size: 13px;
    margin: 7px 0;
}

.price {
    color: var(--brown);
    font-size: 20px;
    font-weight: bold;
    margin: 10px 0 16px;
}

.order-btn {
    display: block;
    text-align: center;
    padding: 11px;
    border: 1px solid var(--brown);
    color: var(--brown);
    transition: .3s;
}

.order-btn:hover {
    background: var(--brown);
    color: white;
}

.banner {
    background: #e9ddcd;
    text-align: center;
    padding: 65px 20px;
}

.banner h2 {
    font-family: Georgia, serif;
    font-size: clamp(30px, 4vw, 45px);
    color: var(--brown);
    margin-bottom: 12px;
}

.banner p {
    margin-bottom: 25px;
    color: #78695c;
}

.about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 45px;
    align-items: center;
}

.about img {
    width: 100%;
    height: 350px;
    object-fit: cover;
}

.about h2 {
    font-family: Georgia, serif;
    font-size: 36px;
    color: var(--brown);
    margin-bottom: 20px;
}

.about p {
    color: #78695c;
    margin-bottom: 20px;
}

footer {
    background: var(--dark);
    color: #eee2d4;
    text-align: center;
    padding: 45px 20px;
}

footer .logo {
    color: white;
    margin-bottom: 10px;
}

footer p {
    font-size: 13px;
    margin: 8px 0;
}

footer a {
    color: #d9b88d;
}

.whatsapp-float {
    position: fixed;
    bottom: 22px;
    right: 20px;
    background: #218c52;
    color: white;
    padding: 13px 18px;
    border-radius: 50px;
    box-shadow: 0 5px 18px #0002;
    z-index: 200;
    font-size: 14px;
}

@media (max-width: 768px) {
    header {
        padding: 15px 5%;
        flex-wrap: wrap;
        gap: 12px;
    }

    .logo {
        font-size: 24px;
    }

    nav {
        gap: 13px;
        flex-wrap: wrap;
    }

    nav a {
        font-size: 12px;
    }

    .nav-btn {
        padding: 7px 10px;
    }

    .hero {
        grid-template-columns: 1fr;
        padding: 45px 5%;
        gap: 30px;
    }

    .hero-image {
        height: 350px;
    }

    section {
        padding: 55px 5%;
    }

    .products {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .product img {
        height: 220px;
    }

    .product-info {
        padding: 14px 12px 0;
    }

    .product-info h3 {
        font-size: 17px;
    }

    .price {
        font-size: 17px;
    }

    .about {
        grid-template-columns: 1fr;
        gap: 25px;
    }

    .about img {
        height: 280px;
    }

    .section-heading h2 {
        font-size: 30px;
    }
}

@media (max-width: 380px) {
    nav {
        gap: 9px;
    }

    .products {
        grid-template-columns: 1fr;
    }

    .product img {
        height: 300px;
    }

    .btn {
        padding: 12px 16px;
    }
}
</style>
</head>

